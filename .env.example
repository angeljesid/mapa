# Puerto público en el equipo anfitrión.
# Si el 8000 está ocupado, cambia este valor (por ejemplo, 8080).
MAPA_PUERTO=8000

# Clave de Gemini para Geo-IA (opcional).
# Si se deja vacía, el servidor usa config/ia_config.json.
GEMINI_API_KEY=

# Protección del enlace (recomendado si usas el túnel público).
# Si defines AMBAS, el navegador pedirá usuario y contraseña.
MAPA_AUTH_USER=
MAPA_AUTH_PASSWORD=
